# ─── Environment Variables Template ────────────────────────────────────────
# Copy file ini menjadi .env (development) atau .env.production (production)
# File ini AMAN untuk di-commit ke git (tidak ada secret)

# Base path aplikasi sesuai deployment target:
#   /                        → Vercel, Netlify, VPS (root domain)
#   /yourksatra-react-vite   → GitHub Pages (subdirectory = nama repo)
VITE_BASE_PATH=/
